# =============================================================================
#  Résidence Khadija — modèle .env pour PRODUCTION (hébergement mutualisé cPanel)
# -----------------------------------------------------------------------------
#  Sur le serveur :
#    1. cp .env.production.example .env
#    2. remplir les valeurs marquées « CHANGER »
#    3. php artisan key:generate      (génère APP_KEY)
#    4. php artisan config:cache
#  NE JAMAIS committer le .env réel (il est dans .gitignore).
# =============================================================================

APP_NAME="Hôtel Résidence Khadija"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://residencekhadija.pits.sn
APP_TIMEZONE=Africa/Dakar

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journaux : rotation quotidienne, 14 jours conservés, niveau « warning »
# (évite qu'un laravel.log unique ne sature le quota disque du mutualisé).
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de données (cPanel > « Bases de données MySQL ») ---------------------
# Les noms cPanel sont préfixés par l'utilisateur du compte, ex. cpuser_khadija.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGER_cpuser_khadija
DB_USERNAME=CHANGER_cpuser_khadija
DB_PASSWORD=CHANGER_mot_de_passe_fort

# --- Session / cache / file (tout en base : pas de Redis sur mutualisé) --------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie de session limité au domaine + envoyé uniquement en HTTPS.
SESSION_DOMAIN=residencekhadija.pits.sn
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- E-mail : SMTP réel requis en production (exemple Brevo) -------------------
# La file d'attente envoie les e-mails ET les SMS : la crontab schedule:run
# (voir DEPLOY.md) doit tourner, sinon rien ne part.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGER@smtp-brevo.com
MAIL_PASSWORD=CHANGER_cle_smtp_brevo
MAIL_FROM_ADDRESS="ne-pas-repondre@residencekhadija.pits.sn"
MAIL_FROM_NAME="${APP_NAME}"
MARKETING_FROM_ADDRESS="contact@residencekhadija.pits.sn"
MARKETING_FROM_NAME="${APP_NAME}"

# --- SMS (config/sms.php) : log (rien n'est envoyé) | http | twilio | orange --
SMS_DRIVER=log
SMS_FROM=KHADIJA
SMS_TRANSACTIONAL=true
SMS_DEFAULT_COUNTRY=221
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=
ORANGE_SMS_SENDER_NAME=Khadija

# --- Assistant KHADJA AI (API Claude) : coller la clé pour l'activer ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Secrets de webhooks entrants (paiement en ligne / channel manager) -------
# À renseigner UNIQUEMENT quand le prestataire correspondant est activé.
PAYMENT_DRIVER=simulator
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_WEBHOOK_SECRET=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_WEBHOOK_SECRET=
CHANNEL_WEBHOOK_SECRET=

# --- Divers vitrine ----------------------------------------------------------
GUEST_WIFI_SSID=
GUEST_WIFI_PASSWORD=
GOOGLE_REVIEW_URL=
TRIPADVISOR_URL=

VITE_APP_NAME="${APP_NAME}"
