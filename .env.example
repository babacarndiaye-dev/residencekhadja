APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail. Par defaut « log » : rien n'est envoye, tout va dans storage/logs/laravel.log.
# Pour un envoi reel : MAIL_MAILER=smtp + hote/identifiants ci-dessous (exemple Brevo),
# puis `php artisan config:clear`. Les e-mails sont MIS EN FILE -> il faut un worker
# (`php artisan queue:work`) ou la crontab `* * * * * php artisan schedule:run`.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@residence-khadija.sn"
MAIL_FROM_NAME="${APP_NAME}"
# Exemple SMTP Brevo (smtp = STARTTLS/587 ; smtps = TLS/465) :
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=xxxxxxx@smtp-brevo.com   (champ "Login" de Brevo -> SMTP & API)
# MAIL_PASSWORD=xsmtpsib-...

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SMS (config/sms.php). driver : log | http | twilio | orange
# Les SMS transactionnels invite sont mis en file (App\Jobs\SendSms) -> worker requis.
SMS_DRIVER=log
SMS_FROM=KHADIJA
SMS_TRANSACTIONAL=true
SMS_DEFAULT_COUNTRY=221
# --- driver http (passerelle REST generique : POST form {from,to,message} + Bearer) ---
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
# --- driver twilio ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# --- driver orange (Orange SMS API - developer.orange.com) ---
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=
ORANGE_SMS_SENDER_NAME=Khadija

# Assistant KHADJA AI (API Claude). Laisser vide pour desactiver l'assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

VITE_APP_NAME="${APP_NAME}"
